{
  "extends": "@tsconfig/node26/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "vite/client",
      "vite-plugin-comlink/client"
    ],
    "noEmit": true
  },
  "include": [
    ".eslintrc.cjs",
    "webpack.config.js",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*",
    "tailwind.config.js",
    "postcss.config.js",
    "scripts/*",
    "src/utils/color/index.ts",
    "src/utils/color/java.ts",
    "mediawiki/ui.js"
  ]
}
